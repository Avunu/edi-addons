<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Internal note nobody is subscribed to: followers (the vendor included)
         never get a notice posted with it. Recipients are chosen explicitly by
         purchase.order._edi_post_notice(). -->
    <record id="mt_edi_notice" model="mail.message.subtype">
        <field name="name">EDI Notice</field>
        <field name="description">EDI Notice</field>
        <field name="res_model">purchase.order</field>
        <field name="internal" eval="True" />
        <field name="default" eval="False" />
        <field name="hidden" eval="True" />
    </record>
</odoo>
