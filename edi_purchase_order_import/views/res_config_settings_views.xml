<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record
        id="res_config_settings_view_form_edi_purchase_order_import"
        model="ir.ui.view"
    >
        <field
            name="name"
        >res.config.settings.view.form.inherit.edi.purchase.order.import</field>
        <field name="model">res.config.settings</field>
        <field
            name="inherit_id"
            ref="purchase.res_config_settings_view_form_purchase"
        />
        <field name="arch" type="xml">
            <setting id="auto_receipt_reminder" position="after">
                <setting
                    id="edi_po_notify_group"
                    help="Group notified in Messages/Inbox when an inbound EDI/email order confirmation creates and confirms a purchase order"
                >
                    <field name="edi_po_notify_group_id" />
                </setting>
            </setting>
        </field>
    </record>
</odoo>
